NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical application URL, also allowlisted in Supabase Auth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gateway AI service — server-only values. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
GATEWAY_MODEL_MODE=openai
GATEWAY_SYNTHESIS_MODEL=gpt-6-luna
GATEWAY_SHOPPER_MODEL=gpt-6-sol
GATEWAY_EVALUATOR_MODEL=gpt-6-sol
# Required for live calls: conservative account/model rate upper bounds (USD / million tokens).
# Every attempt reserves its maximum cost before contacting a provider; failures are not refunded.
GATEWAY_MODEL_PRICING={}
# Live execution is disabled until these owner IDs and positive USD caps are configured.
# Use authenticated Supabase UUIDs; never expose these variables through NEXT_PUBLIC_.
GATEWAY_LIVE_OWNER_IDS=
GATEWAY_OPERATION_USD=
GATEWAY_DAILY_OWNER_USD=
GATEWAY_DAILY_GLOBAL_USD=
# Applies to live and explicit fixture operations; shared persistent filesystem required.
GATEWAY_DAILY_OWNER_JOBS=20
GATEWAY_DAILY_GLOBAL_JOBS=100
GATEWAY_DAILY_OWNER_CALLS=150
GATEWAY_DAILY_GLOBAL_CALLS=500
# Exact origins; '/' permits only the root page. Other prefixes include descendants.
# Add required read-only static asset paths; third-party traffic is blocked.
# Demo policies: config/gateway-demo-environments.json (compact into this variable).
# Optional readOnlyQueryRules: [{"pathPrefix":"/products","names":["variant"]}]
GATEWAY_TEST_ENVIRONMENTS=[{"id":"staging","origin":"https://staging.example.com","allowedPathPrefixes":["/","/products","/collections","/search","/policies","/assets"],"searchPath":"/search","searchQueryParam":"q","allowLoopback":false}]
# Optional: persistent data directory (default .gateway-data), managed Chromium binary override.
# GATEWAY_DATA_DIR=/path/to/persistent/gateway-data
# GATEWAY_CHROMIUM_PATH=/path/to/chrome
